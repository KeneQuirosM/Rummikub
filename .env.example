# ---------- Servidor ----------
# Puerto HTTP/WebSocket
PORT=3001
# Orígenes permitidos (CORS) separados por coma. Vacío = cualquiera.
CORS_ORIGINS=
# Carpeta del cliente compilado a servir (opcional; por defecto ../client/dist o ./public)
STATIC_DIR=
# "false" para no servir el cliente desde el servidor
SERVE_CLIENT=true

# ---------- Cliente (Vite, en tiempo de build) ----------
# URL del servidor Socket.IO cuando el cliente se despliega aparte (Netlify/Vercel).
# Vacío = mismo origen (dev con proxy de Vite o servidor que sirve el cliente).
VITE_SERVER_URL=
# Puerto del servidor al que apunta el proxy de Vite en desarrollo
SERVER_PORT=3001

# Cuentas (opcional, Supabase). Vacío = sin cuentas. La service_role es SECRETA: solo en el servidor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
